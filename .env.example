SECRET_KEY=change-me-in-production
# development | production
# In production: SECRET_KEY is required and must not be the built-in fallback.
BLOOM_ENV=development
# Show login pilot-account shortcuts (auto-on in local demo when SECRET_KEY is the built-in fallback)
# Force off in any shared/staging host: BLOOM_SHOW_PILOTS=0
BLOOM_SHOW_PILOTS=
# Allow demo user seeding when BLOOM_ENV=production (default off — keep off in real deployments)
BLOOM_SEED_DEMO=0
# 1 enables Flask debug reloader (default on in development, off in production)
# Never enable FLASK_DEBUG=1 on a public host.
FLASK_DEBUG=
SESSION_COOKIE_SECURE=
PORT=5001
# Leave empty to use SQLite at instance/bloom.db (local default).
# pgAdmin / Railway: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=gemini
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.8-flash
